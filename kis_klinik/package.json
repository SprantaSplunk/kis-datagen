{
	"name": "kis_klinik",
	"version": "1.0.11",
	"description": "KIS Klinik - Dashboard Studio app for the Splunk Allgemeines Krankenhaus (SAKH)",
	"author": "Alexander Sötz",
	"type": "module",
	"scripts": {
		"build": "node build.mjs --entry=visualization.js",
		"build:prod": "NODE_ENV=production node build.mjs --entry=visualization.js",
		"build:en": "KIS_LANG=en NODE_ENV=production node build.mjs --entry=visualization.js",
		"dev": "node build.mjs --entry=visualization.js --watch",
		"preview": "node build.mjs --entry=visualization.js && node generate-theme-vars.mjs && storybook dev -p 6006",
		"package": "node package.mjs",
		"package:en": "KIS_LANG=en node package.mjs",
		"dashboards": "node dashboards/generate.mjs",
		"dashboards:en": "KIS_LANG=en node dashboards/generate.mjs",
		"check": "node harness/check.mjs",
		"check:esm": "node --experimental-vm-modules harness/check-esm.mjs"
	},
	"devDependencies": {
		"@splunk/dashboard-studio-extension": "^1.0.0",
		"@splunk/themes": "^1.7.2",
		"@storybook/addon-essentials": "^8.0.0",
		"@storybook/react": "^8.0.0",
		"@storybook/react-vite": "^8.0.0",
		"acorn": "^8.19.0",
		"chalk": "^5.3.0",
		"esbuild": "^0.27.3",
		"magic-string": "^0.30.21",
		"playwright-core": "^1.65.1",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"storybook": "^8.0.0",
		"styled-components": "^5.3.10",
		"tar": "^7.4.3"
	}
}
