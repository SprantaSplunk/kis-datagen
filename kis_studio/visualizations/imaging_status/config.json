{
  "showTitleAndDescription": true,
  "includeInToolbar": true,
  "includeInVizSwitcher": true,
  "showDrilldown": true,
  "canSetTokens": ["dynamic"],
  "hasEventHandlers": true,
  "config": {
    "name": "Bildgebung",
    "description": "MRT mit Heliumstand und Kaltkopf, CT mit Roehrenlast: Status der radiologischen Grossgeraete",
    "category": "SAKH",
    "icon": null,
    "dataContract": {
      "requiredDataSources": ["primary"],
      "optionalDataSources": []
    },
    "size": {
      "initialWidth": 1100,
      "initialHeight": 300
    },
    "optionsSchema": {
      "drilldownToken": { "type": "string", "default": "device" },
      "heliumWarn": { "type": "number", "default": 80 },
      "heliumCrit": { "type": "number", "default": 70 },
      "heatWarn": { "type": "number", "default": 70 },
      "heatCrit": { "type": "number", "default": 85 }
    },
    "editorConfig": [
      {
        "label": "MRT Helium (%)",
        "layout": [
          [
            { "editor": "editor.number", "label": "Warnung unter", "option": "heliumWarn" },
            { "editor": "editor.number", "label": "Kritisch unter", "option": "heliumCrit" }
          ]
        ]
      },
      {
        "label": "CT Roehrenlast (%)",
        "layout": [
          [
            { "editor": "editor.number", "label": "Warnung ab", "option": "heatWarn" },
            { "editor": "editor.number", "label": "Kritisch ab", "option": "heatCrit" }
          ]
        ]
      },
      {
        "label": "Interaktion",
        "layout": [[{ "editor": "editor.text", "label": "Drilldown-Feldname", "option": "drilldownToken" }]]
      }
    ]
  }
}
